@{
    ViewData["Title"] = "Kartresultat";
}

<div class="result-content">
    <h1>Kartkoordinater Mottatt</h1>

    <div class="result-item">
        <div class="result-label">Lokasjon</div>
        <div class="result-value">@ViewBag.LocationName</div>
    </div>

    <div class="result-item">
        <div class="result-label">Breddegrad</div>
        <div class="result-value">@ViewBag.Latitude</div>
    </div>

    <div class="result-item">
        <div class="result-label">Lengdegrad</div>
        <div class="result-value">@ViewBag.Longitude</div>
    </div>

    <div class="result-item">
        <div class="result-label">Google Maps</div>
        <div class="result-value">
            <a href="https://maps.google.com/?q=@ViewBag.Latitude,@ViewBag.Longitude" target="_blank">Åpne i Google Maps</a>
        </div>
    </div>

    <div style="margin-top: 2rem;">
        <p><strong>Takk for innlevering!</strong></p>
        <p>
            <a asp-controller="Home" asp-action="Map" class="nav-link">Velg nye koordinater</a>
            <a asp-controller="Home" asp-action="Index" class="nav-link">Tilbake til hjemmen</a>
        </p>
    </div>
</div>
