@model FormSubmissionViewModel
@{
    ViewData["Title"] = "Skjema";
}

<div class="form-container">
    <h1>Skjema</h1>
    <p>Fyll ut skjemaet under. Alle felt er påkrevd.</p>

    <form method="post" asp-action="Form" class="form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label for="firstName">Fornavn <span class="required">*</span></label>
            <input type="text" id="firstName" name="firstName" value="@Model?.FirstName" class="form-control" required />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label for="lastName">Etternavn <span class="required">*</span></label>
            <input type="text" id="lastName" name="lastName" value="@Model?.LastName" class="form-control" required />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label for="email">E-post <span class="required">*</span></label>
            <input type="email" id="email" name="email" value="@Model?.Email" class="form-control" required />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label for="message">Beskrivelse <span class="required">*</span></label>
            <textarea id="message" name="message" rows="5" class="form-control" required>@Model?.Message</textarea>
            <span asp-validation-for="Message" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-submit">Send inn</button>
    </form>
</div>
