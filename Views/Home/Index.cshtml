@{
    ViewData["Title"] = "Hjem";
}

<div class="hero">
    <div class="hero-content">
        <span class="eyebrow">HEIMEVERNET · INNLEVERING 1</span>
        <h1>Velkommen til Heimevernet</h1>
        <p class="hero-lead">En enkel og moderne l&oslash;sning for registrering, kart og innlevering.</p>
        <div class="hero-actions">
            <a asp-controller="Home" asp-action="Form" class="hero-button">Start et skjema</a>
            <a asp-controller="Home" asp-action="Map" class="hero-button secondary">&Aring;pne kartet</a>
        </div>
    </div>
</div>

<section class="home-content home-intro">
    <span class="eyebrow">OVERSIKT</span>
    <h2>Alt samlet p&aring; &eacute;t sted</h2>
    <p>Bruk menyen eller knappene over for &aring; registrere informasjon og velge en plassering direkte i kartet.</p>

    <div class="feature-grid">
        <a asp-controller="Home" asp-action="Form" class="feature-card">
            <span class="feature-icon">&#9998;</span>
            <h3>Skjema</h3>
            <p>Send inn personinformasjon p&aring; en enkel og trygg m&aring;te.</p>
        </a>
        <a asp-controller="Home" asp-action="Map" class="feature-card">
            <span class="feature-icon">&#8982;</span>
            <h3>Kart</h3>
            <p>Klikk i kartet for &aring; velge og registrere koordinater.</p>
        </a>
        <a asp-controller="Home" asp-action="Data" class="feature-card">
            <span class="feature-icon">&#9638;</span>
            <h3>Data</h3>
            <p>Se oversikt over status og videre databaseintegrasjon.</p>
        </a>
    </div>
</section>
