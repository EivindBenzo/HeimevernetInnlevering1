@model HeimevernetInnlevering1.ViewModels.DataPageViewModel
@{
    ViewData["Title"] = "Verifiser";
}

<div class="data-container">
    <span class="eyebrow">DATABASE-VERIFISERING</span>
    <h1>Verifiser lagret data</h1>
    <p>Denne siden leser direkte fra SQLite-databasen (<code>Data/heimevernet.db</code>) hver gang den lastes, uavhengig av økt eller nettleser. Hvis dataene fortsatt vises etter at applikasjonen er restartet, er de lagret permanent.</p>

    <div class="data-status">
        <h2>Antall rader i databasen</h2>
        <p>Skjema-innleveringer: <strong>@Model.FormSubmissions.Count</strong></p>
        <p>Kart-innleveringer: <strong>@Model.MapSubmissions.Count</strong></p>
    </div>

    <section class="current-features">
        <h2>Skjema-innleveringer (fra database)</h2>
        @if (Model.FormSubmissions.Count == 0)
        {
            <p>Ingen rader funnet i tabellen <code>FormSubmissions</code>.</p>
        }
        else
        {
            foreach (var submission in Model.FormSubmissions)
            {
                <article class="result-item">
                    <div class="result-label">Id</div>
                    <div class="result-value">@submission.Id</div>
                    <div class="result-label">Navn</div>
                    <div class="result-value">@submission.FirstName @submission.LastName</div>
                    <div class="result-label">E-post</div>
                    <div class="result-value">@submission.Email</div>
                    <div class="result-label">Beskrivelse</div>
                    <div class="result-value">@submission.Description</div>
                    @if (submission.Latitude.HasValue && submission.Longitude.HasValue)
                    {
                        <div class="result-label">Koblet lokasjon</div>
                        <div class="result-value">@submission.LocationName (@submission.Latitude?.ToString("F6"), @submission.Longitude?.ToString("F6"))</div>
                    }
                    <div class="info">Lagret (UTC): @submission.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm:ss")</div>
                </article>
            }
        }
    </section>

    <section class="integration-guide">
        <h2>Kart-innleveringer (fra database)</h2>
        @if (Model.MapSubmissions.Count == 0)
        {
            <p>Ingen rader funnet i tabellen <code>MapSubmissions</code>.</p>
        }
        else
        {
            foreach (var submission in Model.MapSubmissions)
            {
                <article class="result-item">
                    <div class="result-label">Id</div>
                    <div class="result-value">@submission.Id</div>
                    <div class="result-label">Lokasjon</div>
                    <div class="result-value">@submission.LocationName</div>
                    <div class="result-label">Koordinater</div>
                    <div class="result-value">@submission.Latitude.ToString("F6"), @submission.Longitude.ToString("F6")</div>
                    <div class="info">Lagret (UTC): @submission.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm:ss")</div>
                </article>
            }
        }
    </section>
</div>
