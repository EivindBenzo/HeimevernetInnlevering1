@model HeimevernetInnlevering1.ViewModels.DataPageViewModel
@{
    ViewData["Title"] = "Data";
}

<div class="data-container">
    <span class="eyebrow">LAGRET INFORMASJON</span>
    <h1>Data og innlevering</h1>
    <p>Informasjon som er sendt inn gjennom skjemaet og kartet.</p>

    <section class="current-features">
        <h2>Skjema-innleveringer</h2>
        @if (Model.FormSubmissions.Count == 0)
        {
            <p>Det finnes ingen skjema-innleveringer ennå.</p>
        }
        else
        {
            foreach (var submission in Model.FormSubmissions)
            {
                <article class="result-item">
                    <div class="result-label">Navn</div>
                    <div class="result-value">@submission.FirstName @submission.LastName</div>
                    <div class="result-label">E-post</div>
                    <div class="result-value">@submission.Email</div>
                    <div class="result-label">Beskrivelse</div>
                    <div class="result-value">@submission.Description</div>
                    <div class="info">Sendt inn @submission.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                </article>
            }
        }
    </section>

    <section class="integration-guide">
        <h2>Kart-innleveringer</h2>
        @if (Model.MapSubmissions.Count == 0)
        {
            <p>Det finnes ingen kart-innleveringer ennå.</p>
        }
        else
        {
            foreach (var submission in Model.MapSubmissions)
            {
                <article class="result-item">
                    <div class="result-label">Lokasjon</div>
                    <div class="result-value">@submission.LocationName</div>
                    <div class="result-label">Koordinater</div>
                    <div class="result-value">@submission.Latitude.ToString("F6"), @submission.Longitude.ToString("F6")</div>
                    <div class="info">Sendt inn @submission.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                </article>
            }
        }
    </section>
</div>
