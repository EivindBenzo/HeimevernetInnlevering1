@{
    ViewData["Title"] = "Kart";
}

<h1>Kart</h1>

<form method="post" asp-action="Map">
    <label for="locationName">Lokasjonsnavn</label>
    <input type="text" id="locationName" name="locationName" value="Oslo" required />

    <label for="latitude">Breddegrad</label>
    <input type="number" id="latitude" name="latitude" step="any" value="59.9139" required />

    <label for="longitude">Lengdegrad</label>
    <input type="number" id="longitude" name="longitude" step="any" value="10.7522" required />

    <button type="submit">Vis kart</button>
</form>