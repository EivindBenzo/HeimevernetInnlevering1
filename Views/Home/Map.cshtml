@model MapSubmissionViewModel
@{
    ViewData["Title"] = "Kart";
}

<div class="map-container">
    <span class="eyebrow">LOKASJON</span>
    <h1>Kart</h1>
    <p>Klikk på kartet for å velge en lokasjon, eller skriv inn koordinatene manuelt.</p>

    <form method="post" asp-action="Map" class="form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label for="locationName">Lokasjonsnavn <span class="required">*</span></label>
            <input type="text" id="locationName" name="locationName" value="@(Model?.LocationName ?? "Oslo")" class="form-control" required />
            <span asp-validation-for="LocationName" class="text-danger"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="latitude">Breddegrad <span class="required">*</span></label>
                <input type="number" id="latitude" name="latitude" step="0.000001" value="@(Model?.Latitude ?? 59.9139)" class="form-control" required />
                <span asp-validation-for="Latitude" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="longitude">Lengdegrad <span class="required">*</span></label>
                <input type="number" id="longitude" name="longitude" step="0.000001" value="@(Model?.Longitude ?? 10.7522)" class="form-control" required />
                <span asp-validation-for="Longitude" class="text-danger"></span>
            </div>
        </div>

        <p class="info">Standardkoordinater: Oslo (59.9139°N, 10.7522°E). Klikk i kartet for å oppdatere feltene automatisk.</p>
        <div id="map" aria-label="Interaktivt kart"></div>
        <button type="submit" class="btn-submit">Vis kart</button>
    </form>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    const startLat = @(Model?.Latitude ?? 59.9139);
    const startLng = @(Model?.Longitude ?? 10.7522);
    const map = L.map('map').setView([startLat, startLng], 12);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    let marker = L.marker([startLat, startLng]).addTo(map);
    marker.bindPopup('Valgt lokasjon').openPopup();

    map.on('click', function (event) {
        const latitude = event.latlng.lat;
        const longitude = event.latlng.lng;
        document.getElementById('latitude').value = latitude.toFixed(6);
        document.getElementById('longitude').value = longitude.toFixed(6);

        if (marker) map.removeLayer(marker);
        marker = L.marker([latitude, longitude]).addTo(map);
        marker.bindPopup('Latitude: ' + latitude.toFixed(6) + '<br>Longitude: ' + longitude.toFixed(6)).openPopup();
    });
</script>
