@model MapSubmissionViewModel
@{
    ViewData["Title"] = "Kart";
}

<div class="map-container">
    <span class="eyebrow">LOKASJON</span>
    <h1>Kart</h1>
    <p>Søk etter en by eller klikk på kartet for å velge en lokasjon.</p>

    <form method="post" asp-action="Map" class="form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group city-search-group">
            <label for="citySearch">Søk etter by</label>
            <input type="text" id="citySearch" class="form-control" placeholder="Skriv navnet på en by, f.eks. Bergen" autocomplete="off" />
            <ul id="citySuggestions" class="city-suggestions"></ul>
            <span class="info" id="citySearchStatus"></span>
        </div>

        <div class="form-group">
            <label for="locationName">Lokasjonsnavn <span class="required">*</span></label>
            <input type="text" id="locationName" name="locationName" value="@(Model?.LocationName ?? "Oslo")" class="form-control" required />
            <span asp-validation-for="LocationName" class="text-danger"></span>
        </div>

        <input type="hidden" id="latitude" name="latitude" value="@((Model?.Latitude ?? 59.9139).ToString(System.Globalization.CultureInfo.InvariantCulture))" />
        <input type="hidden" id="longitude" name="longitude" value="@((Model?.Longitude ?? 10.7522).ToString(System.Globalization.CultureInfo.InvariantCulture))" />

        <p class="info">Standardlokasjon: Oslo. Søk etter en by eller klikk i kartet for å velge lokasjon.</p>
        <div id="map" aria-label="Interaktivt kart"></div>
        <button type="submit" class="btn-submit">Vis kart</button>
    </form>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    const startLat = @((Model?.Latitude ?? 59.9139).ToString(System.Globalization.CultureInfo.InvariantCulture));
    const startLng = @((Model?.Longitude ?? 10.7522).ToString(System.Globalization.CultureInfo.InvariantCulture));
    const map = L.map('map').setView([startLat, startLng], 12);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    let marker = L.marker([startLat, startLng]).addTo(map);
    marker.bindPopup('Valgt lokasjon').openPopup();

    function setLocation(lat, lng, label) {
        map.setView([lat, lng], 12);

        if (marker) map.removeLayer(marker);
        marker = L.marker([lat, lng]).addTo(map);
        marker.bindPopup(label || ('Latitude: ' + lat.toFixed(6) + '<br>Longitude: ' + lng.toFixed(6))).openPopup();

        document.getElementById('latitude').value = lat;
        document.getElementById('longitude').value = lng;
    }

    map.on('click', function (event) {
        const latitude = event.latlng.lat;
        const longitude = event.latlng.lng;
        setLocation(latitude, longitude, 'Latitude: ' + latitude.toFixed(6) + '<br>Longitude: ' + longitude.toFixed(6));
    });

    // City search with autocomplete using OpenStreetMap Nominatim
    const citySearchInput = document.getElementById('citySearch');
    const citySuggestionsList = document.getElementById('citySuggestions');
    const citySearchStatus = document.getElementById('citySearchStatus');
    const locationNameInput = document.getElementById('locationName');

    let searchTimeout = null;
    let currentController = null;

    function clearSuggestions() {
        citySuggestionsList.innerHTML = '';
        citySuggestionsList.classList.remove('open');
    }

    function renderSuggestions(results) {
        clearSuggestions();

        if (!results || results.length === 0) {
            return;
        }

        results.forEach(function (place) {
            const item = document.createElement('li');
            item.className = 'city-suggestion-item';
            item.textContent = place.display_name;

            item.addEventListener('click', function () {
                const lat = parseFloat(place.lat);
                const lng = parseFloat(place.lon);
                const shortName = place.display_name.split(',')[0];

                locationNameInput.value = shortName;
                citySearchInput.value = place.display_name;

                setLocation(lat, lng, place.display_name);
                clearSuggestions();
            });

            citySuggestionsList.appendChild(item);
        });

        citySuggestionsList.classList.add('open');
    }

    citySearchInput.addEventListener('input', function () {
        const query = citySearchInput.value.trim();

        if (searchTimeout) clearTimeout(searchTimeout);

        if (query.length < 2) {
            clearSuggestions();
            citySearchStatus.textContent = '';
            return;
        }

        citySearchStatus.textContent = 'Søker...';

        searchTimeout = setTimeout(function () {
            if (currentController) currentController.abort();
            currentController = new AbortController();

            const url = 'https://nominatim.openstreetmap.org/search?format=json&addressdetails=0&limit=6&q=' + encodeURIComponent(query);

            fetch(url, { signal: currentController.signal, headers: { 'Accept-Language': 'no,en' } })
                .then(function (response) { return response.json(); })
                .then(function (data) {
                    citySearchStatus.textContent = data.length === 0 ? 'Ingen treff' : '';
                    renderSuggestions(data);
                })
                .catch(function (error) {
                    if (error.name !== 'AbortError') {
                        citySearchStatus.textContent = 'Kunne ikke hente forslag akkurat nå.';
                    }
                });
        }, 400);
    });

    document.addEventListener('click', function (event) {
        if (!citySuggestionsList.contains(event.target) && event.target !== citySearchInput) {
            clearSuggestions();
        }
    });
</script>
