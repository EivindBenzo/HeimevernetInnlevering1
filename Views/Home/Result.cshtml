@{
    ViewData["Title"] = "Resultat";
}

<div class="result-content">
    <h1>Innlevering Mottatt</h1>

    <div class="result-item">
        <div class="result-label">Navn</div>
        <div class="result-value">@ViewBag.Name</div>
    </div>

    <div class="result-item">
        <div class="result-label">E-post</div>
        <div class="result-value">@ViewBag.Email</div>
    </div>

    <div class="result-item">
        <div class="result-label">Melding</div>
        <div class="result-value">@ViewBag.Message</div>
    </div>

    <div style="margin-top: 2rem;">
        <p><strong>Takk for innlevering!</strong></p>
        <p>
            <a asp-controller="Home" asp-action="Form" class="btn-submit" style="display: inline-block; width: auto; margin-top: 0;">Fyll inn nytt skjema</a>
            <a asp-controller="Home" asp-action="Index" style="margin-left: 1rem; color: #1e40af; text-decoration: none;">Tilbake til hjemmen</a>
        </p>
    </div>
</div>
