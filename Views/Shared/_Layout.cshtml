<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Heimevernet</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="nav-container">
                <div class="nav-brand">Heimevernet Innlevering 1</div>
                <ul class="nav-menu">
                    <li><a asp-controller="Home" asp-action="Index" class="nav-link">Hjem</a></li>
                    <li><a asp-controller="Home" asp-action="Form" class="nav-link">Skjema</a></li>
                    <li><a asp-controller="Home" asp-action="Map" class="nav-link">Kart</a></li>
                    <li><a asp-controller="Home" asp-action="Data" class="nav-link">Data</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer>
        <p>&copy; 2026 Heimevernet Innlevering 1 - ASP.NET Core MVC</p>
    </footer>
</body>
</html>
